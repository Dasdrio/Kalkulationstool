<Page x:Class="Kalkulationstool.vorwaerts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kalkulationstool"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vorwaerts">

    <Grid Background="White">
        <Button x:Name="Rechnung" Content="Rechnen" HorizontalAlignment="Center" Margin="0,361,0,0" VerticalAlignment="Top" Height="45" Width="96" Click="Rechnung_Click"/>
        <Label Content="Listeineikaufspreis pro Stück:" Margin="222,85,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="162"/>
        <TextBox x:Name="TB_listeneinkaufspreis" HorizontalAlignment="Left" Margin="400,90,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Lieferrabatt in %:" Margin="222,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="162"/>
        <TextBox x:Name="TB_lieferrabatt" HorizontalAlignment="Left" Margin="400,114,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Lieferskonto in %" Margin="222,135,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="162"/>
        <TextBox x:Name="TB_lieferskonto" HorizontalAlignment="Left" Margin="400,139,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Bezugskosten pro Stück" Margin="222,160,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="162"/>
        <TextBox x:Name="TB_bezugskosten" HorizontalAlignment="Left" Margin="400,164,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Handlungskostenzuschlag in %" Margin="222,185,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173"/>
        <TextBox x:Name="TB_Handlungskosten" HorizontalAlignment="Left" Margin="400,189,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Gewinnzuschlag in %:" Margin="222,210,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173"/>
        <TextBox x:Name="TB_gewinn" HorizontalAlignment="Left" Margin="400,214,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Kundenskonto in %" Margin="222,235,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173"/>
        <TextBox x:Name="TB_Kundenskonto" HorizontalAlignment="Left" Margin="400,239,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Vertreterprovision in %" Margin="222,260,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173"/>
        <TextBox x:Name="TB_Provision" HorizontalAlignment="Left" Margin="400,264,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Kundenrabatt in %" Margin="222,285,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173"/>
        <TextBox x:Name="TB_Kundenrabatt" HorizontalAlignment="Left" Margin="400,289,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Umsatzsteuer in %" Margin="222,310,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173"/>
        <TextBox x:Name="TB_steuer" HorizontalAlignment="Left" Margin="400,314,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Page>
