      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kalkulationstool"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vorwaerts">

    <Grid>
        <Button x:Name="Rechnung" Content="Button" HorizontalAlignment="Center" Margin="0,292,0,0" VerticalAlignment="Top" Height="45" Width="96" Click="Rechnung_Click"/>
        <Label Content="Listeineikaufspreis:" HorizontalAlignment="Center" Margin="0,168,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Listeneinkaufspreis" HorizontalAlignment="Center" Margin="0,225,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Page>
