<Page x:Class="Kalkulationstool.kalkulation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kalkulationstool"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="kalkulation">

    <Grid Background="White">
        <Label Content="Kalkulation" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Height="38" Width="110" FontSize="20" Grid.Row="1" Grid.Column="3" Grid.RowSpan="1"/>
        <Label Content="Listeneinkaufspreis" HorizontalAlignment="Left" Margin="259,55,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Listeneinkaufspreis" HorizontalAlignment="Left" Margin="485,63,0,0" TextWrapping="Wrap" Text="Listeneinkaufspreis" VerticalAlignment="Top" Grid.RowSpan="1"/>
        <Label Content="Lieferrabatt" HorizontalAlignment="Left" Margin="259,73,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Lieferrabatt" HorizontalAlignment="Left" Margin="485,81,0,0" TextWrapping="Wrap" Text="Lieferrabatt" VerticalAlignment="Top" Grid.RowSpan="1"/>
        <Label Content="Zieleinkaufspreis" HorizontalAlignment="Left" Margin="259,90,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
