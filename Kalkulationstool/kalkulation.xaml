        <Label Content="Lieferskonto" HorizontalAlignment="Left" Margin="259,107,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Lieferskonto" HorizontalAlignment="Left" Margin="485,115,0,0" TextWrapping="Wrap" Text="Lieferskonto" VerticalAlignment="Top" Height="21" Grid.RowSpan="1"/>
        <Label Content="Bareinkauspreis" HorizontalAlignment="Left" Margin="259,123,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Bareinkauspreis" HorizontalAlignment="Left" Margin="485,131,0,0" TextWrapping="Wrap" Text="Bareinkauspreis" VerticalAlignment="Top" Height="21" Grid.RowSpan="1"/>
        <Label x:Name="___Kein_Name_" Content="Bezugskosten" HorizontalAlignment="Left" Margin="259,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Bezugskosten" HorizontalAlignment="Left" Margin="485,148,0,0" TextWrapping="Wrap" Text="Bezugskosten" VerticalAlignment="Top" Height="21" Grid.RowSpan="1"/>
        <Label Content="Bezugspreis" HorizontalAlignment="Left" Margin="259,156,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Bezugspreis" HorizontalAlignment="Left" Margin="485,164,0,0" TextWrapping="Wrap" Text="Bezugspreis" VerticalAlignment="Top" Height="21" Grid.RowSpan="1"/>
        <Label Content="Handlungskostenzuschlag" HorizontalAlignment="Left" Margin="259,171,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Handlungskostenzuschlag" HorizontalAlignment="Left" Margin="485,179,0,0" TextWrapping="Wrap" Text="Handlungskostenzuschlag" VerticalAlignment="Top" Height="21" Grid.RowSpan="1"/>
        <Label Content="Selbstkosten" HorizontalAlignment="Left" Margin="259,187,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Selbstkosten" HorizontalAlignment="Left" Margin="485,195,0,0" TextWrapping="Wrap" Text="Selbstkosten" VerticalAlignment="Top" Height="21" Grid.RowSpan="1"/>
