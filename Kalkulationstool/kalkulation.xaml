        <Label x:Name="Kundenskonto" Content="Kundenskonto und Vertreterprovision" HorizontalAlignment="Left" Margin="259,237,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="skonto_und_provision" HorizontalAlignment="Left" Margin="485,243,0,0" TextWrapping="Wrap" Text="Kundenskonto" VerticalAlignment="Top" Height="20" Grid.RowSpan="1"/>
        <Label Content="Zielverkaufspreis" HorizontalAlignment="Left" Margin="259,252,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Zielverkaufspreis" HorizontalAlignment="Left" Margin="485,258,0,0" TextWrapping="Wrap" Text="Zielverkaufspreis" VerticalAlignment="Top" Height="20" Grid.RowSpan="1"/>
        <Label Content="Kundenrabatt" HorizontalAlignment="Left" Margin="259,268,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Kundenrabatt" HorizontalAlignment="Left" Margin="485,274,0,0" TextWrapping="Wrap" Text="Kundenrabatt" VerticalAlignment="Top" Height="20" Grid.RowSpan="1"/>
        <Label Content="Nettoverkaufspreis" HorizontalAlignment="Left" Margin="259,283,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Nettoverkaufspreis" HorizontalAlignment="Left" Margin="485,289,0,0" TextWrapping="Wrap" Text="Nettoverkaufspreis" VerticalAlignment="Top" Height="20" Grid.RowSpan="1"/>
        <Label Content="Umsatzsteuer" HorizontalAlignment="Left" Margin="259,299,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Umsatzsteuer" HorizontalAlignment="Left" Margin="485,305,0,0" TextWrapping="Wrap" Text="Umsatzsteuer" VerticalAlignment="Top" Height="20" Grid.RowSpan="1"/>
        <Label Content="Bruttoverkaufspreis" HorizontalAlignment="Left" Margin="259,314,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.023,-0.49" Grid.RowSpan="1"/>
        <TextBlock x:Name="Bruttoverkaufspreis" HorizontalAlignment="Left" Margin="485,320,0,0" TextWrapping="Wrap" Text="Bruttoverkaufspreis" VerticalAlignment="Top" Height="20" Grid.RowSpan="1"/>
        <Button Content="Zurück ins Menü" HorizontalAlignment="Left" Margin="27,28,0,0" VerticalAlignment="Top" Height="40" Width="100" Click="Button_Click"/>
        <Label Content="Angaben in €" HorizontalAlignment="Left" Margin="484,38,0,0" VerticalAlignment="Top"/>

    </Grid>
</Page>
